PROJECT_NAME           = "Graph Recognition Library"
PROJECT_BRIEF          = "C++11 header-only library for graph class recognition algorithms"
OUTPUT_DIRECTORY       = _doxygen
OUTPUT_LANGUAGE        = English

INPUT                  = ../include
FILE_PATTERNS          = *.h
RECURSIVE              = NO

GENERATE_XML           = YES
XML_OUTPUT             = xml

GENERATE_HTML          = NO
GENERATE_LATEX         = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

BUILTIN_STL_SUPPORT    = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

QUIET                  = YES
WARNINGS               = YES

# Suppress include graph generation (avoids "graph too large" warnings)
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

# Raise the dot graph threshold for the remaining graphs
DOT_GRAPH_MAX_NODES    = 200
MAX_DOT_GRAPH_DEPTH    = 4
